     }));
+    // Performance counters and tuning knobs (docs/PORTING.md "Performance").
+    // GET: counters since launch and the knobs; POST: {"knob": integer, ...},
+    // every name and range checked by the title (-1 restores a default).
+    auto ps5lm_stats = []() {
+        auto res = std::make_unique<server_http_res>();
+        char buffer[2048];
+        const int n = ps5lm_server_stats(buffer, sizeof(buffer));
+        if (n <= 0 || (size_t) n >= sizeof(buffer)) {
+            throw std::runtime_error("ps5lm stats do not fit");
+        }
+        res->data = std::string(buffer, (size_t) n);
+        return res;
+    };
+    ctx_http.get("/ps5lm/stats", ex_wrapper([ps5lm_stats](const server_http_req &) {
+        return ps5lm_stats();
+    }));
+    ctx_http.post("/ps5lm/knobs", ex_wrapper([ps5lm_stats](const server_http_req & req) {
+        const json body = json::parse(req.body);
+        if (!body.is_object()) {
+            throw std::invalid_argument("knobs: expected an object");
+        }
+        for (const auto & [name, value] : body.items()) {
+            if (!value.is_number_integer()) {
+                throw std::invalid_argument("knobs: " + name + " is not an integer");
+            }
+        }
+        for (const auto & [name, value] : body.items()) {
+            if (ps5lm_server_set_knob(name.c_str(), value.get<long long>()) != 0) {
+                throw std::invalid_argument("knobs: unknown knob or value out of range: " + name);
+            }
+        }
+        return ps5lm_stats();
+    }));
 #endif
 
