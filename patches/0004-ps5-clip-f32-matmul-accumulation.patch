+
+#if defined(__PROSPERO__)
+// PS5LM (native PS5 title): every matrix multiplication of the encoder graph
+// (patch-embedding conv's im2col matmul, QKV/output/FFN/merger/deepstack
+// projections, non-flash attention) requests F32 accumulation. With F16
+// weights at the default precision ggml-vulkan picks its FP16-accumulating
+// matmul pipelines (coopmat is off in the title), whose error over K = 4096
+// put the image embedding 7 % from the CPU's. Text-model graphs are unchanged.
+static ggml_cgraph * clip_ps5lm_f32_accumulation(ggml_cgraph * gf) {
+    for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+        ggml_tensor * node = ggml_graph_node(gf, i);
+        if (node->op == GGML_OP_MUL_MAT) {
+            ggml_prec_set_acc(node, GGML_PREC_F32);
+        }
+    }
+    return gf;
 }
+#else
+static ggml_cgraph * clip_ps5lm_f32_accumulation(ggml_cgraph * gf) { return gf; }
+#endif
 
