#version 450
// Exactly one workgroup; no atomics, images, shared memory or floating point.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) writeonly buffer Output {
    uint words[64];
} output_buffer;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    output_buffer.words[i] = i * 3u + 7u;
}
